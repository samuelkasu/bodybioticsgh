root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,config}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
dotnet_style_prefer_conditional_expression_over_return = false
dotnet_diagnostic.CA1062.severity = none # ASP.NET Core never passes null into handlers

# EF Core writes these files; holding generated code to hand-written standards
# means every migration starts with a build failure.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1814.severity = none
dotnet_analyzer_diagnostic.severity = none
