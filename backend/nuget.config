<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Ignore whatever feeds happen to be configured on a developer's machine:
       the restore must resolve identically here and in CI. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
